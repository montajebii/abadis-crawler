# شناسه‌ی یکتای این دستگاه (هر دستگاه Termux یک مقدار تصادفی)
DEVICE_ID=change-me-uuid

# مسیر دیتابیس محلی برای ذخیره‌ی وضعیت و کش
LOCAL_DB_PATH=./local_state.db

# مسیر خروجی CSV (قبل از commit به data/raw/)
OUTPUT_CSV=./output.csv

# حداکثر تعداد واژه در هر اجرا (برای cron روی Termux)
MAX_WORDS_PER_RUN=200

# حالت debug
DEBUG=false
